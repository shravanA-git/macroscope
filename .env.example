# FRED API key (optional — basic series work without it, but key removes rate limits)
# Get one free at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_key_here

# Environment
ENVIRONMENT=development

# Frontend API base URL (set to production URL after Vercel deploy)
NEXT_PUBLIC_API_URL=http://localhost:8000
